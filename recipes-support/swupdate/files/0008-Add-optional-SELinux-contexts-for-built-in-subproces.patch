 		read_settings_user_id(&handle, "suricatta", &uid, &gid);
-		start_subprocess(SOURCE_SURICATTA, "suricatta", uid, gid,
+		start_subprocess(SOURCE_SURICATTA, "suricatta", uid, gid, context,
 				 cfgfname, argcount,
 				 argvalues, start_suricatta);
 
@@ -1171,8 +1177,11 @@ int main(int argc, char **argv)
 	if (opt_d) {
 		uid_t uid;
 		gid_t gid;
+		const char *context;
+		if (read_settings_selinux_context(&handle, "download", &context))
+			exit(EXIT_FAILURE);
 		read_settings_user_id(&handle, "download", &uid, &gid);
-		start_subprocess(SOURCE_DOWNLOADER, "download", uid, gid,
+		start_subprocess(SOURCE_DOWNLOADER, "download", uid, gid, context,
 				 cfgfname, dwlac,
 				 dwlav, start_download_server);
 		freeargs(dwlav);
@@ -1182,8 +1191,11 @@ int main(int argc, char **argv)
 	{
 		uid_t uid;
 		gid_t gid;
+		const char *context;
+		if (read_settings_selinux_context(&handle, "download", &context))
+			exit(EXIT_FAILURE);
 		read_settings_user_id(&handle, "download", &uid, &gid);
-		start_subprocess(SOURCE_CHUNKS_DOWNLOADER, "chunks_downloader", uid, gid,
+		start_subprocess(SOURCE_CHUNKS_DOWNLOADER, "chunks_downloader", uid, gid, context,
 				cfgfname, 0, NULL,
 				start_delta_downloader);
 	}
diff --git a/corelib/swupdate_settings.c b/corelib/swupdate_settings.c
index 229fac9d..b9f7f3aa 100644
--- a/corelib/swupdate_settings.c
+++ b/corelib/swupdate_settings.c
@@ -147,6 +147,32 @@ int read_settings_user_id(swupdate_cfg_handle *handle, const char *module, uid_t
 }
 
 
+int read_settings_selinux_context(swupdate_cfg_handle *handle, const char *module,
+				 const char **context)
+{
+	config_setting_t *elem, *setting;
+
+	*context = NULL;
+	elem = find_settings_node(&handle->cfg, module);
+	if (!elem)
+		return 0;
+
+	setting = config_setting_get_member(elem, "selinux-context");
+	if (!setting)
+		return 0;
+
+	if (config_setting_type(setting) != CONFIG_TYPE_STRING) {
+		ERROR("%s.selinux-context must be a string", module);
+		return -EINVAL;
+	}
+
+	*context = config_setting_get_string(setting);
+	if (!(*context)[0])
+		*context = NULL;
+
+	return 0;
+}
+
 /*
  * Callback to be used to put a section of configuration
  * into a dictionary
diff --git a/doc/source/swupdate.rst b/doc/source/swupdate.rst
index 216535d9..6a31f7fb 100644
--- a/doc/source/swupdate.rst
+++ b/doc/source/swupdate.rst
@@ -236,6 +236,30 @@ To configure the options:
 
 	make menuconfig
 
+SELinux subprocess contexts
+---------------------------
+
+Enable ``CONFIG_SELINUX`` (requires ``libselinux``) and set contexts
+in ``swupdate.cfg`` for Suricatta, the web server and downloaders::
+
+    suricatta : {
+        selinux-context = "system_u:system_r:swupdate_suricatta_t:s0";
+    };
+
+    webserver : {
+        selinux-context = "system_u:system_r:swupdate_webserver_t:s0";
+    };
+
+    download : {
+        selinux-context = "system_u:system_r:swupdate_download_t:s0";
+    };
+
+Both the downloader and the delta chunks downloader use ``download``.
+Omitted or empty settings preserve the inherited context.
+A requested context that cannot be applied prevents the child from starting.
+
+Replace these example contexts with ones defined by your SELinux policy.
+
 Building
 --------
 
