From 663900e33e6335503d5be82b47141da4f5a5a973 Mon Sep 17 00:00:00 2001
From: Ayoub Zaki <ayoub.zaki@embetrix.com>
Date: Wed, 30 Sep 2026 19:49:49 +0200
Subject: [PATCH] Add optional SELinux contexts for built-in subprocesses

Add CONFIG_SELINUX and selinux-context settings for Suricatta, the web
server and downloaders.
Startup will fail if a context cannot be set.

Upstream-Status: Pending
Signed-off-by: Ayoub Zaki <ayoub.zaki@embetrix.com>
---
 Kconfig                             | 17 +++++++++++++++++
 Makefile.deps                       |  8 ++++++++
 Makefile.flags                      |  4 ++++
 core/pctl.c                         | 36 +++++++++++++++++++++++++++++++++---
 core/swupdate.c                     | 20 ++++++++++++++++----
 corelib/swupdate_settings.c         | 26 ++++++++++++++++++++++++++
 doc/source/swupdate.rst             | 24 ++++++++++++++++++++++++
 examples/configuration/swupdate.cfg |  9 +++++++++
 include/pctl.h                      |  1 +
 include/swupdate_settings.h         |  2 ++
 10 files changed, 140 insertions(+), 7 deletions(-)

diff --git a/Kconfig b/Kconfig
index 615a622a..c6c0b3cc 100644
--- a/Kconfig
+++ b/Kconfig
@@ -97,6 +97,10 @@ config HAVE_LIBSYSTEMD
 	bool
 	option env="HAVE_LIBSYSTEMD"
 
+config HAVE_LIBSELINUX
+	bool
+	option env="HAVE_LIBSELINUX"
+
 config HAVE_LIBCRYPTO
 	bool
 	option env="HAVE_LIBCRYPTO"
@@ -161,6 +165,19 @@ config SYSTEMD
 comment "systemd support needs libsystemd"
 	depends on !HAVE_LIBSYSTEMD && HAVE_LINUX
 
+config SELINUX
+	bool "enable SELinux subprocess contexts"
+	depends on HAVE_LINUX && HAVE_LIBSELINUX
+	default n
+	help
+	  Allow Suricatta, web-server and downloaders to use
+	  contexts specified by selinux-context in their configuration
+	  sections.
+	  Requires libselinux and a policy permitting the transitions.
+
+comment "SELinux support needs libselinux"
+	depends on !HAVE_LIBSELINUX && HAVE_LINUX
+
 config DEFAULT_CONFIG_FILE
 	string "File with default settings"
 	default "/etc/swupdate.cfg"
diff --git a/Makefile.deps b/Makefile.deps
index 35f1bd6b..794e8eed 100644
--- a/Makefile.deps
+++ b/Makefile.deps
@@ -90,6 +90,14 @@ export HAVE_LIBSYSTEMD = n
 endif
 endif
 
+ifeq ($(HAVE_LIBSELINUX),)
+ifeq ($(HAVE_LINUX),y)
+export HAVE_LIBSELINUX = y
+else
+export HAVE_LIBSELINUX = n
+endif
+endif
+
 ifeq ($(HAVE_LIBCRYPTO),)
 export HAVE_LIBCRYPTO = y
 endif
diff --git a/Makefile.flags b/Makefile.flags
index 435bf3c8..7fb243f2 100644
--- a/Makefile.flags
+++ b/Makefile.flags
@@ -151,6 +151,10 @@ endif
 # libconfig is always compiled
 LDLIBS += config
 
+ifeq ($(CONFIG_SELINUX),y)
+LDLIBS += selinux
+endif
+
 # libarchive
 ifeq ($(CONFIG_ARCHIVE),y)
 LDLIBS += archive
diff --git a/core/pctl.c b/core/pctl.c
index 0e0edc28..af0e66c2 100644
--- a/core/pctl.c
+++ b/core/pctl.c
@@ -26,6 +26,10 @@
 #include <parselib.h>
 #include <swupdate_settings.h>
 
+#ifdef CONFIG_SELINUX
+#include <selinux/selinux.h>
+#endif
+
 #ifndef WAIT_ANY
 #define WAIT_ANY (-1)
 #endif
@@ -125,6 +129,7 @@ void wait_threads_ready(void)
  */
 static int spawn_process(struct swupdate_task *task,
 			uid_t run_as_userid, gid_t run_as_groupid,
+			const char *selinux_context,
 			const char *cfgname,
 			int ac, char **av,
 			swupdate_process start,
@@ -177,6 +182,26 @@ static int spawn_process(struct swupdate_task *task,
 		}
 	}
 
+	/* Apply the requested SELinux context before starting the child process */
+	if (selinux_context && selinux_context[0]) {
+#ifdef CONFIG_SELINUX
+		if (is_selinux_enabled() <= 0) {
+			ERROR("Cannot set SELinux context for %s: SELinux is not enabled",
+			      task->name);
+			return -1;
+		}
+		if (setcon(selinux_context) < 0) {
+			ERROR("Cannot set SELinux context %s for %s: %s",
+			      selinux_context, task->name, strerror(errno));
+			return -1;
+		}
+#else
+		ERROR("Cannot set SELinux context for %s: built without SELinux support",
+		      task->name);
+		return -1;
+#endif
+	}
+
 	/* Save new pid */
 	pid = getpid();
 
@@ -209,6 +234,7 @@ static int spawn_process(struct swupdate_task *task,
 
 static void start_swupdate_subprocess(sourcetype type, const char *name,
 			uid_t run_as_userid, gid_t run_as_groupid,
+			const char *selinux_context,
 			const char* cfgfile,
 			int argc, char **argv,
 			swupdate_process start,
@@ -216,7 +242,8 @@ static void start_swupdate_subprocess(sourcetype type, const char *name,
 {
 	procs[nprocs].name = name;
 	procs[nprocs].type = type;
-	if (spawn_process(&procs[nprocs], run_as_userid, run_as_groupid, cfgfile, argc, argv, start, cmdline) < 0) {
+	if (spawn_process(&procs[nprocs], run_as_userid, run_as_groupid,
+			  selinux_context, cfgfile, argc, argv, start, cmdline) < 0) {
 		ERROR("Spawning %s failed, exiting process...", name);
 		exit(1);
 	}
@@ -232,17 +259,20 @@ void start_subprocess_from_file(sourcetype type, const char *name,
 			int argc, char **argv,
 			const char *cmdline)
 {
-	start_swupdate_subprocess(type, name, run_as_userid, run_as_groupid, cfgfile, argc, argv, NULL, cmdline);
+	start_swupdate_subprocess(type, name, run_as_userid, run_as_groupid,
+				 NULL, cfgfile, argc, argv, NULL, cmdline);
 }
 
 void start_subprocess(sourcetype type, const char *name,
 			uid_t run_as_userid, gid_t run_as_groupid,
+			const char *selinux_context,
 			const char *cfgfile,
 			int argc, char **argv,
 			swupdate_process start)
 {
 
-	start_swupdate_subprocess(type, name, run_as_userid, run_as_groupid, cfgfile, argc, argv, start, NULL);
+	start_swupdate_subprocess(type, name, run_as_userid, run_as_groupid,
+				 selinux_context, cfgfile, argc, argv, start, NULL);
 }
 
 /*
