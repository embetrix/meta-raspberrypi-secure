#
# ab-verify-slot: verify a pending A/B update on the first boot into the
# updated slot then either confirm it or rollback
#
# SWUpdate sets these U-Boot env variables on a successful install:
#   upgrade_available  = 1     an update is awaiting verification
#   update_target_slot = A|B   the slot the update was written to
#   ustate             = 1     SWUpdate update state STATE_INSTALLED
#
# This clears upgrade_available and moves ustate to STATE_OK (0) on a confirmed
# update or STATE_FAILED (3) on a rollback.
#
# Decision (running slot is read from the firmware device-tree node):
#   running == target + healthy   -> rpi-ab-update -c (make permanent), ustate=0
#   running == target + unhealthy -> if tryboot, reboot to fall back else mark failed
#   running != target             -> firmware already rolled back -> ustate=3
#

set -e

BOOT_SLOT_DT="/proc/device-tree/chosen/bootloader/partition"
TRYBOOT_DT="/proc/device-tree/chosen/bootloader/tryboot"

die() {

    echo "ERROR: $1" >&2
    exit 1
}

get_env() {

    fw_printenv -n "$1" 2>/dev/null || true
}

detect_slot() {

    [ -e "$BOOT_SLOT_DT" ] || die "Boot slot DT node not available"

    boot_hex=$(hexdump -v -e '/1 "%02x"' "$BOOT_SLOT_DT" 2>/dev/null) || true
    case "$boot_hex" in
        00000002) ACTIVE_SLOT="A" ;;
        00000003) ACTIVE_SLOT="B" ;;
        *) die "Unknown boot slot: $boot_hex" ;;
    esac
}

# True if this boot used the one-shot tryboot (firmware falls back on next reboot)
is_tryboot() {

    [ -e "$TRYBOOT_DT" ] || return 1
    th=$(hexdump -v -e '/1 "%02x"' "$TRYBOOT_DT" 2>/dev/null) || true
    [ "$th" = "00000001" ]
}

# Healthy only if there are no failed systemd units
is_healthy() {

    failed=$(systemctl --failed --no-legend 2>/dev/null)
    if [ -z "$failed" ]; then
        echo "Health check passed: no failed systemd units"
        return 0
    fi

    echo "Health check failed: failed systemd units:"
    echo "$failed"
    return 1
}

# Report the final update result to hawkBit via the suricatta IPC. Best-effort:
# silently ignored if suricatta is disabled or the daemon is not running
# Args: <finished: success|failure> <status: state.h value> <message>
report_hawkbit() {

    swupdate-ipc sendtohawkbit 0 "$2" "$1" closed "$3" 2>/dev/null \
        || echo "hawkbit: feedback not sent (suricatta off or daemon down)"
}

ua=$(get_env upgrade_available)
if [ "$ua" != "1" ]; then
    echo "No pending update (upgrade_available='${ua:-unset}') normal boot"
    exit 0
fi

detect_slot
target=$(get_env update_target_slot)
echo "Pending update: target slot '${target:-unset}' running slot '$ACTIVE_SLOT'"

if [ "$ACTIVE_SLOT" != "$target" ]; then
    # The firmware did not boot the target slot: the tryboot one-shot lapsed
    # and we fell back to the previous slot.
    echo "ROLLBACK: expected slot '$target' but running '$ACTIVE_SLOT' update failed"
    fw_setenv upgrade_available
    fw_setenv ustate 3   # STATE_FAILED
    report_hawkbit failure 3 "A/B update rolled back: slot $target did not boot"
    exit 0
fi

if is_healthy; then
    # Reuse the existing slot-switch logic to make the slot permanent.
    rpi-ab-update -c
    fw_setenv upgrade_available
    fw_setenv ustate   # STATE_OK
    echo "Update to slot $ACTIVE_SLOT CONFIRMED successful"
    report_hawkbit success 0 "A/B update confirmed on slot $ACTIVE_SLOT"
else
    echo "Update unhealthy on slot $ACTIVE_SLOT"
    if is_tryboot; then
        # tryboot is one-shot: a plain reboot returns to the previous slot.
        # Leave upgrade_available/ustate so the fallback boot logs the ROLLBACK.
        echo "rebooting to rollback to the previous slot..."
        sync
        reboot
    else
        # Not a tryboot boot: this slot is already the permanent default, so a
        # reboot would loop back here. Cannot auto-roll back; mark it failed.
        echo "WARNING: slot already permanent (not tryboot), cannot auto-rollback"
        fw_setenv ustate 3   # STATE_FAILED
        fw_setenv upgrade_available
        report_hawkbit failure 3 "A/B update unhealthy on slot $ACTIVE_SLOT (already permanent)"
    fi
fi
