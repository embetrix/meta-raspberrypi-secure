software =
{
		version = "@@RPI_SECURE_VERSION@@";

		files: (
			{
				name      = "boot-signed";
				version   = "@@RPI_SECURE_VERSION@@";
				filename  = "boot-signed.tar.gz";
				path      = "/var/boot-update/";
				type      = "archive";
				encrypted = true;
				sha256    = "$swupdate_get_sha256(boot-signed.tar.gz)";
				install-if-different = true;
			}
		);

		images:  (
			{
				name       = "rootfs";
				version    = "@@RPI_SECURE_VERSION@@";
				filename   = "@@IMAGE@@-@@MACHINE@@.rootfs.@@ROOTFS_TYPE@@.avbverity.gz";
				device     = "/dev/mapper/update";
				type       = "raw";
				compressed = "zlib";
				encrypted  = true;
				sha256     = "$swupdate_get_sha256(@@IMAGE@@-@@MACHINE@@.rootfs.@@ROOTFS_TYPE@@.avbverity.gz)";
				install-if-different = true;
			}
		);
}
