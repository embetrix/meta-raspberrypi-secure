[openssl_init]
providers   = provider_sect
alg_section = algorithm_sect

[algorithm_sect]
# Prefer the default provider for generic operations (ephemeral EC keygen
# for TLS 1.3 ECDHE, hashing, RNG). pkcs11-provider stays active so the
# explicit "pkcs11:" URI still resolves token-backed keys via OSSL_STORE.
default_properties = ?provider=default

[provider_sect]
default = default_sect
pkcs11  = pkcs11_sect

[default_sect]
activate = 1

[pkcs11_sect]
module = /usr/lib/ossl-modules/pkcs11.so
pkcs11-module-path = /usr/lib/pkcs11/rpifwcrypto-pkcs11.so
activate = 1
