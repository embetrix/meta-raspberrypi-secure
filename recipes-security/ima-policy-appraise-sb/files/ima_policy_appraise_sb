#
# IMA/EVM extended secure boot appraise policy
# Extends the hardware secure boot chain into the Linux by
# enforcing ima/evm signatures verification on :
# executables, libraries, kernel modules, ima policy and firmware on all filesystems
#
# Documentation: https://ima-doc.readthedocs.io/en/latest/policy-syntax.html
#


# Enforce signature checks for :

## Executables
appraise func=BPRM_CHECK mask=MAY_EXEC appraise_type=imasig

## Shared Libraries
appraise func=MMAP_CHECK mask=MAY_EXEC appraise_type=imasig

## Firmware
appraise func=FIRMWARE_CHECK appraise_type=imasig

## Kernel Modules
appraise func=MODULE_CHECK appraise_type=imasig

## IMA Policy itself 
appraise func=POLICY_CHECK appraise_type=imasig
