#
# IMA/EVM extended secure boot appraise policy
# Extends the hardware secure boot chain into the Linux by
# enforcing ima/evm signatures verification on :
# executables, libraries, kernel modules, ima policy and firmware on all filesystems
#
# Documentation: https://ima-doc.readthedocs.io/en/latest/policy-syntax.html
#

# Exclude pseudo filesystems from measurement
dont_measure fsmagic=0x9fa0     # procfs
dont_measure fsmagic=0x62656572 # sysfs
dont_measure fsmagic=0x01021994 # tmpfs
dont_measure fsmagic=0x64626720 # debugfs
dont_measure fsmagic=0x73636673 # securityfs
dont_measure fsmagic=0x858458f6 # ramfs
dont_measure fsmagic=0x1cd1     # devpts

# Measure into TPM PCR 10 (default) and if no TPM is present measurements
# are recorded in the IMA log only without PCR extension
measure func=BPRM_CHECK               # Executables
measure func=MMAP_CHECK mask=MAY_EXEC # Shared Libraries
measure func=MODULE_CHECK             # Kernel Modules
measure func=FIRMWARE_CHECK           # Firmware
measure func=POLICY_CHECK             # IMA Policy

# Enforce signature checks for :

## Executables
appraise func=BPRM_CHECK mask=MAY_EXEC appraise_type=imasig

## Shared Libraries
appraise func=MMAP_CHECK mask=MAY_EXEC appraise_type=imasig

## Firmware
appraise func=FIRMWARE_CHECK appraise_type=imasig

## Kernel Modules
appraise func=MODULE_CHECK appraise_type=imasig

## IMA Policy itself 
appraise func=POLICY_CHECK appraise_type=imasig
