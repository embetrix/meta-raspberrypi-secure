## Filesystem tamper detection (read-only rootfs: triggers indicate remount or overlay breach)
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config_readonly -p wa -k sshd
-w /etc/audit/ -p wa -k audit-config
-w /etc/nftables/ -p wa -k firewall
-w /etc/usbguard/ -p wa -k usbguard
-w /etc/systemd/system/ -p wa -k systemd

## Mount operations: detect remount rw attempts
-a always,exit -F arch=b64 -S mount,umount2 -k mount

## Kernel module loading
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules

## Privilege escalation
-a never,exit -F arch=b64 -S setuid,setgid,setreuid,setregid,setresuid,setresgid -F exe=/usr/sbin/sshd
-a never,exit -F arch=b64 -S setuid,setgid,setreuid,setregid,setresuid,setresgid -F exe=/usr/lib/systemd/systemd-executor
-a always,exit -F arch=b64 -S setuid,setgid,setreuid,setregid,setresuid,setresgid -k privilege

## ptrace: process injection attempts
-a always,exit -F arch=b64 -S ptrace -k ptrace

## Time changes
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time

## System integrity: reboot, hostname tampering
-a always,exit -F arch=b64 -S reboot -k reboot
-a always,exit -F arch=b64 -S sethostname,setdomainname -k hostname

## Log integrity (only track deletion: too noisy)
-w /var/log/ -p a -k log-tamper
