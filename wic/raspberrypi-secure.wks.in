# Description: Create a secure Raspberry Pi GPT disk image 
# with A/B boot and root partitions plus data and backup volumes
part /    --ondisk mmcblk0  --part-name boot       --fixed-size 512M   --fstype=vfat  --source bootfiles-partition --align 4096 --active 
part /    --ondisk mmcblk0  --part-name bootA      --fixed-size 512M   --fstype=vfat  --source bootimg-partition
part /    --ondisk mmcblk0  --part-name bootB      --fixed-size 512M   --fstype=vfat
part /    --ondisk mmcblk0  --part-name rootA      --fixed-size 2048M
part /    --ondisk mmcblk0  --part-name rootB      --fixed-size 2048M  --fstype=${ROOTFS_TYPE}  --source avb-verity
part /    --ondisk mmcblk0  --part-name data       --fixed-size 4096M  --fstype=ext4
part /    --ondisk mmcblk0  --part-name backups    --fixed-size 4096M  --fstype=ext4
bootloader --ptable gpt
