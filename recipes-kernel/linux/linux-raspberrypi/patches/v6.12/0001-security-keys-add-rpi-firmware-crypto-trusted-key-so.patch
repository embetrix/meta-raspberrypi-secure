diff --git a/security/keys/trusted-keys/trusted_rpifwcrypto.c b/security/keys/trusted-keys/trusted_rpifwcrypto.c
new file mode 100644
index 000000000000..764ec676a552
--- /dev/null
+++ b/security/keys/trusted-keys/trusted_rpifwcrypto.c
@@ -0,0 +1,417 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Trusted keys backed by Raspberry Pi VideoCore firmware OTP crypto
+ *
+ * Copyright (C) 2026
+ * Embetrix Embedded Systems Solutions, ayoub.zaki@embetrix.com
+ *
+ * Largely inspired by the DCP (Data Co-Processor) trusted key implementation
+ * by sigma star GmbH (security/keys/trusted-keys/trusted_dcp.c)
+ */
+
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/key.h>
+#include <linux/key-type.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/random.h>
+#include <linux/slab.h>
+#include <linux/scatterlist.h>
+#include <linux/crypto.h>
+#include <crypto/aead.h>
+#include <keys/trusted_rpifwcrypto.h>
+#include <soc/bcm2835/raspberrypi-firmware.h>
+
+#define RPFW_MAGIC   0x52504657U  /* "RPFW" */
+#define RPFW_NONCE_LEN        32  /* HMAC input / per-key salt    */
+#define RPFW_IV_LEN           12  /* AES-GCM standard IV length   */
+#define RPFW_TAG_LEN          16  /* AES-GCM authentication tag   */
+#define RPFW_WRAP_KEY_LEN     32  /* AES-256 key from HMAC output */
+
+#define RPI_FIRMWARE_GET_CRYPTO_NUM_OTP_KEYS   0x0003008fU
+#define RPI_FIRMWARE_GET_CRYPTO_HMAC_SHA256    0x00030092U
+
+/**
+ * DOC: rpifwcrypto blob format
+ *
+ * The Raspberry Pi VideoCore firmware provides an HMAC-SHA256 operation keyed
+ * by a device-unique OTP key slot that never leaves the firmware. It does not
+ * perform key sealing directly, so we define a custom blob format that uses the
+ * firmware-derived wrapping key to seal the trusted key payload.
+ *
+ * Whenever a new trusted key is created, a random 32-byte nonce and 12-byte IV
+ * are generated. The nonce is passed to the firmware as the HMAC message,
+ * the 32-byte HMAC output becomes the AES-256 wrapping key. The trusted key
+ * payload is then encrypted with AES-256-GCM using that wrapping key and the
+ * random IV. The blob header (magic, key_id, nonce, iv, key_len) is
+ * authenticated as AAD, so any tampering with it is detected at unseal time.
+ *
+ * Blob layout::
+ *
+ *   +----------------------+--------+
+ *   | struct rpfw_blob_hdr | 54 B   |  authenticated (AAD)
+ *   +----------------------+--------+
+ *   | ciphertext           | key_len|  encrypted payload
+ *   +----------------------+--------+
+ *   | GCM auth tag         | 16 B   |  authentication tag
+ *   +----------------------+--------+
+ *
+ * Total blob size: 54 + key_len + 16 bytes.
+ */
+
+/**
+ * struct rpfw_blob_hdr - header of an rpifwcrypto trusted key blob
+ *
+ * @magic:   Magic identifier always %RPFW_MAGIC (``"RPFW"`` little-endian)
+ * @key_id:  OTP key slot used to derive the wrapping key via HMAC-SHA256
+ * @nonce:   Random 32-byte value passed as the HMAC message; a fresh nonce is
+ *           generated for every seal operation so that each blob uses a
+ *           distinct wrapping key
+ * @iv:      Random 12-byte AES-GCM IV unique per seal operation
+ * @key_len: Length of the plaintext trusted key in bytes
+ *
+ * The entire header is used as Additional Authenticated Data (AAD) for
+ * AES-256-GCM so modification of any field is detected at unseal time.
+ */
+struct rpfw_blob_hdr {
+	__le32  magic;
+	__le32  key_id;
+	u8      nonce[RPFW_NONCE_LEN];
+	u8      iv[RPFW_IV_LEN];
+	__le16  key_len;
+} __packed;
+
+#define RPFW_BLOB_OVERHEAD  (sizeof(struct rpfw_blob_hdr) + RPFW_TAG_LEN)
+
+static struct rpi_firmware *rpfw_fw;
+static u32 rpfw_key_id = 1;
+
+struct rpfw_hmac_req {
+	__le32  flags;                     /* reserved, set to 0 */
+	__le32  key_id;                    /* OTP key slot */
+	__le32  length;                    /* message length in bytes */
+	u8      message[RPFW_NONCE_LEN];   /* the nonce message */
+} __packed;
+
+struct rpfw_hmac_resp {
+	__le32  status;                    /* 0 = success, else error code */
+	__le32  length;                    /* HMAC output length (32) */
+	u8      hmac[RPFW_WRAP_KEY_LEN];   /* HMAC-SHA256 output */
+} __packed;
+
+union rpfw_hmac_buf {
+	struct rpfw_hmac_req  req;
+	struct rpfw_hmac_resp resp;
+};
+
+module_param_named(rpifwcrypto_key_id, rpfw_key_id, uint, 0444);
+MODULE_PARM_DESC(rpifwcrypto_key_id,
+		 "OTP key slot for AES-256-GCM wrapping key derivation (trusted.rpifwcrypto_key_id=N, default: 1)");
+
+static int rpfw_get_fw(void)
+{
+	if (!rpfw_fw) {
+		pr_err("rpifwcrypto: firmware handle not available\n");
+		return -ENODEV;
+	}
+	return 0;
+}
+
+static int rpfw_derive_wrap_key(const u8 *nonce, u8 *wrap_key)
+{
+	union rpfw_hmac_buf buf = {};
+	int ret;
+
+	ret = rpfw_get_fw();
+	if (ret)
+		return ret;
+
+	buf.req.flags  = cpu_to_le32(0);
+	buf.req.key_id = cpu_to_le32(rpfw_key_id);
+	buf.req.length = cpu_to_le32(RPFW_NONCE_LEN);
+	memcpy(buf.req.message, nonce, RPFW_NONCE_LEN);
+
+	ret = rpi_firmware_property(rpfw_fw,
+				    RPI_FIRMWARE_GET_CRYPTO_HMAC_SHA256,
+				    &buf, sizeof(buf));
+	if (ret) {
+		pr_err("rpifwcrypto: HMAC mailbox call failed for key_id=%u: %d (is slot programmed? use trusted.rpifwcrypto_key_id=N)\n",
+		       rpfw_key_id, ret);
+		goto out;
+	}
+
+	if (le32_to_cpu(buf.resp.status) != 0) {
+		pr_err("rpifwcrypto: HMAC firmware error %u for key_id=%u (KEY_NOT_SET=6, KEY_NOT_FOUND=3, KEY_LOCKED=4)\n",
+		       le32_to_cpu(buf.resp.status), rpfw_key_id);
+		ret = -EIO;
+		goto out;
+	}
+
+	if (le32_to_cpu(buf.resp.length) != RPFW_WRAP_KEY_LEN) {
+		pr_err("rpifwcrypto: unexpected HMAC length %u (expected %u)\n",
+		       le32_to_cpu(buf.resp.length), RPFW_WRAP_KEY_LEN);
+		ret = -EIO;
+		goto out;
+	}
+
+	memcpy(wrap_key, buf.resp.hmac, RPFW_WRAP_KEY_LEN);
+out:
+	memzero_explicit(&buf, sizeof(buf));
+	return ret;
+}
+
+static int rpfw_aead_op(const u8 *wrap_key, const u8 *iv,
+			const u8 *aad, size_t aad_len,
+			const u8 *in, size_t in_len,
+			u8 *out, bool encrypt)
+{
+	struct crypto_aead *tfm;
+	struct aead_request *req;
+	struct scatterlist sg;
+	DECLARE_CRYPTO_WAIT(wait);
+	u8 *buf;
+	size_t cryptlen, buf_len;
+	int ret;
+
+	if (encrypt) {
+		cryptlen = in_len;
+		buf_len  = aad_len + in_len + RPFW_TAG_LEN;
+	} else {
+		if (in_len <= RPFW_TAG_LEN)
+			return -EINVAL;
+
+		cryptlen = in_len;	/* ciphertext + tag */
+		buf_len  = aad_len + in_len;
+	}
+
+	buf = kzalloc(buf_len, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	memcpy(buf, aad, aad_len);
+	memcpy(buf + aad_len, in, in_len);
+
+	tfm = crypto_alloc_aead("gcm(aes)", 0, 0);
+	if (IS_ERR(tfm)) {
+		ret = PTR_ERR(tfm);
+		goto out_free_buf;
+	}
+
+	ret = crypto_aead_setkey(tfm, wrap_key, RPFW_WRAP_KEY_LEN);
+	if (ret)
+		goto out_free_tfm;
+
+	ret = crypto_aead_setauthsize(tfm, RPFW_TAG_LEN);
+	if (ret)
+		goto out_free_tfm;
+
+	req = aead_request_alloc(tfm, GFP_KERNEL);
+	if (!req) {
+		ret = -ENOMEM;
+		goto out_free_tfm;
+	}
+
+	sg_init_one(&sg, buf, buf_len);
+
+	aead_request_set_callback(req,
+				  CRYPTO_TFM_REQ_MAY_BACKLOG |
+				  CRYPTO_TFM_REQ_MAY_SLEEP,
+				  crypto_req_done, &wait);
+	aead_request_set_crypt(req, &sg, &sg, cryptlen, (u8 *)iv);
+	aead_request_set_ad(req, aad_len);
+
+	ret = crypto_wait_req(encrypt ? crypto_aead_encrypt(req)
+						: crypto_aead_decrypt(req),
+					&wait);
+	if (!ret) {
+		/* encrypt output: ciphertext + tag; decrypt output: plaintext only */
+		size_t out_len = encrypt ? (cryptlen + RPFW_TAG_LEN)
+					 : (cryptlen - RPFW_TAG_LEN);
+		memcpy(out, buf + aad_len, out_len);
+	}
+
+	aead_request_free(req);
+
+out_free_tfm:
+	crypto_free_aead(tfm);
+out_free_buf:
+	memzero_explicit(buf, buf_len);
+	kfree(buf);
+	return ret;
+}
+
+static int rpfw_seal(struct trusted_key_payload *p, char *datablob)
+{
+	struct rpfw_blob_hdr *hdr;
+	u8 nonce[RPFW_NONCE_LEN];
+	u8 iv[RPFW_IV_LEN];
+	u8 wrap_key[RPFW_WRAP_KEY_LEN];
+	size_t blob_len;
+	int ret;
+
+	if (p->key_len < MIN_KEY_SIZE || p->key_len > MAX_KEY_SIZE)
+		return -EINVAL;
+
+	blob_len = RPFW_BLOB_OVERHEAD + p->key_len;
+	if (blob_len > MAX_BLOB_SIZE)
+		return -EOVERFLOW;
+
+	/* Fresh random nonce and IV for every seal */
+	get_random_bytes(nonce, sizeof(nonce));
+	get_random_bytes(iv, sizeof(iv));
+
+	ret = rpfw_derive_wrap_key(nonce, wrap_key);
+	if (ret)
+		goto out;
+
+	/* Fill in the header (also serves as AAD) */
+	hdr = (struct rpfw_blob_hdr *)p->blob;
+	hdr->magic   = cpu_to_le32(RPFW_MAGIC);
+	hdr->key_id  = cpu_to_le32(rpfw_key_id);
+	memcpy(hdr->nonce, nonce, RPFW_NONCE_LEN);
+	memcpy(hdr->iv, iv, RPFW_IV_LEN);
+	hdr->key_len = cpu_to_le16(p->key_len);
+
+	ret = rpfw_aead_op(wrap_key, iv,
+			   (u8 *)hdr, sizeof(*hdr),
+			   p->key, p->key_len,
+			   p->blob + sizeof(*hdr),
+			   true);
+	if (ret) {
+		pr_err("rpifwcrypto: seal encrypt failed: %d\n", ret);
+		goto out;
+	}
+
+	p->blob_len = blob_len;
+
+out:
+	memzero_explicit(wrap_key, sizeof(wrap_key));
+	return ret;
+}
+
+static int rpfw_unseal(struct trusted_key_payload *p, char *datablob)
+{
+	struct rpfw_blob_hdr *hdr;
+	u8 wrap_key[RPFW_WRAP_KEY_LEN];
+	u16 key_len;
+	size_t expected_blob_len;
+	int ret;
+
+	if (p->blob_len < RPFW_BLOB_OVERHEAD + MIN_KEY_SIZE)
+		return -EINVAL;
+
+	hdr = (struct rpfw_blob_hdr *)p->blob;
+
+	if (le32_to_cpu(hdr->magic) != RPFW_MAGIC)
+		return -EINVAL;
+
+	key_len = le16_to_cpu(hdr->key_len);
+	if (key_len < MIN_KEY_SIZE || key_len > MAX_KEY_SIZE)
+		return -EINVAL;
+
+	expected_blob_len = RPFW_BLOB_OVERHEAD + key_len;
+	if (p->blob_len != expected_blob_len)
+		return -EINVAL;
+
+	/*
+	 * Only allow unsealing with the currently configured key_id.
+	 * Rejecting mismatches prevents an attacker from re-sealing a blob
+	 * under a different (weaker) key slot.
+	 */
+	if (le32_to_cpu(hdr->key_id) != rpfw_key_id) {
+		pr_warn("rpifwcrypto: blob key_id %u != configured key_id %u\n",
+			le32_to_cpu(hdr->key_id), rpfw_key_id);
+		return -EINVAL;
+	}
+
+	/*
+	 * Re-derive the wrapping key from the same nonce embedded in the
+	 * blob. On the same device with the same OTP key this reproduces
+	 * the original wrap_key exactly.
+	 */
+	ret = rpfw_derive_wrap_key(hdr->nonce, wrap_key);
+	if (ret)
+		goto out;
+
+	/*
+	 * Decrypt: ciphertext+tag = p->blob[sizeof(*hdr) .. blob_len]
+	 * Output written into p->key.
+	 * The AAD is the header; GCM will reject any tampered blob.
+	 */
+	ret = rpfw_aead_op(wrap_key, hdr->iv,
+			   (u8 *)hdr, sizeof(*hdr),
+			   p->blob + sizeof(*hdr), key_len + RPFW_TAG_LEN,
+			   p->key,
+			   false);
+	if (ret) {
+		pr_err("rpifwcrypto: unseal decrypt failed: %d\n", ret);
+		goto out;
+	}
+
+	p->key_len = key_len;
+
+out:
+	memzero_explicit(wrap_key, sizeof(wrap_key));
+	return ret;
+}
+
+static int rpfw_init(void)
+{
+	struct device_node *fw_np;
+	struct rpi_firmware *fw;
+	__le32 num_keys_buf = 0;
+	int ret;
+
+	fw_np = of_find_compatible_node(NULL, NULL, "raspberrypi,bcm2835-firmware");
+	if (!fw_np) {
+		pr_err("rpifwcrypto: firmware DT node not found\n");
+		return -ENODEV;
+	}
+
+	fw = rpi_firmware_get(fw_np);
+	of_node_put(fw_np);
+	if (IS_ERR_OR_NULL(fw)) {
+		pr_err("rpifwcrypto: could not get firmware handle (%ld)\n",
+		       fw ? PTR_ERR(fw) : -ENODEV);
+		return fw ? PTR_ERR(fw) : -ENODEV;
+	}
+
+	ret = rpi_firmware_property(fw, RPI_FIRMWARE_GET_CRYPTO_NUM_OTP_KEYS,
+				    &num_keys_buf, sizeof(num_keys_buf));
+	if (ret) {
+		pr_err("rpifwcrypto: firmware OTP crypto not supported (tag 0x%08x: %d)\n",
+		       RPI_FIRMWARE_GET_CRYPTO_NUM_OTP_KEYS, ret);
+		rpi_firmware_put(fw);
+		return -ENODEV;
+	}
+
+	rpfw_fw = fw;
+
+	pr_info("rpifwcrypto: ready, %u OTP key slot(s), using slot %u\n",
+		le32_to_cpu(num_keys_buf), rpfw_key_id);
+
+	ret = register_key_type(&key_type_trusted);
+	if (ret) {
+		rpi_firmware_put(rpfw_fw);
+		rpfw_fw = NULL;
+	}
+	return ret;
+}
+
+static void rpfw_exit(void)
+{
+	unregister_key_type(&key_type_trusted);
+	if (rpfw_fw) {
+		rpi_firmware_put(rpfw_fw);
+		rpfw_fw = NULL;
+	}
+}
+
+struct trusted_key_ops trusted_key_rpifwcrypto_ops = {
+	.init       = rpfw_init,
+	.seal       = rpfw_seal,
+	.unseal     = rpfw_unseal,
+	.exit       = rpfw_exit,
+	.migratable = 0,
+};
