+	select CRYPTO_AES
+	select CRYPTO_GCM
+	select HAVE_TRUSTED_KEYS
+	default y
+	help
+	  Enable use of the Raspberry Pi VideoCore firmware OTP-backed
+	  HMAC-SHA256 as trusted key backend. Keys are sealed with
+	  AES-256-GCM using a hardware-bound wrapping key derived from
